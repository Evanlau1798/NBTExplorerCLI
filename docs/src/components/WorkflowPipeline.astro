---
import type { LocaleKey } from '../data/cli-surface';

interface Step {
  step: string;
  title: string;
  cmd: string;
  tier: 'safe' | 'preview' | 'write';
}

interface Props {
  kind: 'edit' | 'translate';
  lang?: LocaleKey;
}

const { kind, lang = 'en' } = Astro.props;

const pipelines: Record<'edit' | 'translate', Record<LocaleKey, Step[]>> = {
  edit: {
    en: [
      { step: '01', title: 'Read Value', cmd: 'get --types', tier: 'safe' },
      { step: '02', title: 'Preview Plan', cmd: 'set / plan', tier: 'preview' },
      { step: '03', title: 'Apply Offline', cmd: 'apply', tier: 'write' },
      { step: '04', title: 'Check or Undo', cmd: 'status / recover', tier: 'safe' },
    ],
    'zh-tw': [
      { step: '01', title: '讀取原值', cmd: 'get --types', tier: 'safe' },
      { step: '02', title: '預覽計畫', cmd: 'set / plan', tier: 'preview' },
      { step: '03', title: '離線套用', cmd: 'apply', tier: 'write' },
      { step: '04', title: '檢查復原', cmd: 'status / recover', tier: 'safe' },
    ],
  },
  translate: {
    en: [
      { step: '01', title: 'Start', cmd: 'translate start', tier: 'preview' },
      { step: '02', title: 'Translate', cmd: 'export -> submit', tier: 'preview' },
      { step: '03', title: 'Build Plan', cmd: 'translate plan', tier: 'preview' },
      { step: '04', title: 'Apply', cmd: 'apply -> seal', tier: 'write' },
    ],
    'zh-tw': [
      { step: '01', title: '建立進度', cmd: 'translate start', tier: 'preview' },
      { step: '02', title: '分頁翻譯', cmd: 'export -> submit', tier: 'preview' },
      { step: '03', title: '產生計畫', cmd: 'translate plan', tier: 'preview' },
      { step: '04', title: '套用封存', cmd: 'apply -> seal', tier: 'write' },
    ],
  },
};

const steps = pipelines[kind][lang] ?? pipelines[kind].en;
---

<div class="nbt-pipeline not-content">
  {
    steps.map((s) => (
      <div class="nbt-pipeline-step" data-tier={s.tier}>
        <div class="nbt-pipeline-head">
          <span class="nbt-pipeline-badge">{s.step}</span>
          <span class="nbt-pipeline-title">{s.title}</span>
        </div>
        <code class="nbt-pipeline-cmd">{s.cmd}</code>
      </div>
    ))
  }
</div>

<style>
  .nbt-pipeline {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    margin: 1.35rem 0 1.75rem;
    border: 1px solid var(--nbt-border-strong);
    border-radius: 10px;
    background: var(--nbt-border);
    overflow: hidden;
  }

  .nbt-pipeline-step {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    padding: 0.95rem 1.05rem;
    background: var(--nbt-surface);
    transition: background-color 0.14s ease;
  }

  .nbt-pipeline-step:hover {
    background: var(--nbt-surface-elevated);
  }

  .nbt-pipeline-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .nbt-pipeline-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.1rem 0.38rem;
    border-radius: 4px;
    font-family: var(--sl-font-mono);
    font-size: 0.7rem;
    font-weight: 650;
    font-variant-numeric: tabular-nums;
    border: 1px solid transparent;
  }

  .nbt-pipeline-step[data-tier='safe'] .nbt-pipeline-badge {
    background: rgba(52, 211, 153, 0.1);
    border-color: rgba(52, 211, 153, 0.3);
    color: #6ee7b7;
  }

  .nbt-pipeline-step[data-tier='preview'] .nbt-pipeline-badge {
    background: rgba(251, 191, 36, 0.1);
    border-color: rgba(251, 191, 36, 0.3);
    color: #fde68a;
  }

  .nbt-pipeline-step[data-tier='write'] .nbt-pipeline-badge {
    background: rgba(248, 113, 113, 0.12);
    border-color: rgba(248, 113, 113, 0.32);
    color: #fca5a5;
  }

  :root[data-theme='light'] .nbt-pipeline-step[data-tier='safe'] .nbt-pipeline-badge {
    background: #f0fdf4;
    border-color: #bbf7d0;
    color: #166534;
  }

  :root[data-theme='light'] .nbt-pipeline-step[data-tier='preview'] .nbt-pipeline-badge {
    background: #fffbeb;
    border-color: #fde68a;
    color: #92400e;
  }

  :root[data-theme='light'] .nbt-pipeline-step[data-tier='write'] .nbt-pipeline-badge {
    background: #fef2f2;
    border-color: #fecaca;
    color: #991b1b;
  }

  .nbt-pipeline-title {
    font-weight: 600;
    font-size: 0.875rem;
    color: var(--sl-color-white);
    white-space: nowrap;
  }

  .nbt-pipeline-cmd {
    font-family: var(--sl-font-mono);
    font-size: 0.74rem;
    color: var(--sl-color-gray-1);
    background: var(--nbt-surface-code);
    border: 1px solid var(--nbt-border);
    padding: 0.22rem 0.48rem;
    border-radius: 5px;
    align-self: flex-start;
    white-space: nowrap;
  }

  @media (max-width: 760px) {
    .nbt-pipeline {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 440px) {
    .nbt-pipeline {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
