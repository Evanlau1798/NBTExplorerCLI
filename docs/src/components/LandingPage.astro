---
import '../styles/landing.css';
import LandingHero from './LandingHero.astro';
import LandingFeatures from './LandingFeatures.astro';
import logoDark from '../assets/logo.svg';
import { LANDING_COPY } from '../data/landing-i18n';
import { PRODUCT_META, type LocaleKey } from '../data/cli-surface';

interface Props {
  lang: LocaleKey;
}

const { lang } = Astro.props;
const copy = LANDING_COPY[lang] ?? LANDING_COPY.en;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pageHref = (path: string) => base + path;
const homePath = lang === 'zh-tw' ? '/zh-tw/' : '/';
const alternateLang = lang === 'zh-tw' ? 'en' : 'zh-TW';
const siteUrl = Astro.site ?? Astro.url;
const absoluteHref = (path: string) => new URL(pageHref(path), siteUrl).href;
const title = PRODUCT_META.name + ' — ' + copy.pageTitle;
---

<!doctype html>
<html lang={copy.langAttr} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#06090f" />
    <title>{title}</title>
    <meta name="description" content={copy.heroSubtitle} />
    <link rel="icon" type="image/svg+xml" href={pageHref('/favicon.svg')} />
    <link rel="canonical" href={absoluteHref(homePath)} />
    <link rel="alternate" hreflang="en" href={absoluteHref('/')} />
    <link rel="alternate" hreflang="zh-TW" href={absoluteHref('/zh-tw/')} />
    <link rel="alternate" hreflang="x-default" href={absoluteHref('/')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={PRODUCT_META.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={copy.heroSubtitle} />
    <meta property="og:url" content={absoluteHref(homePath)} />
    <meta property="og:locale" content={lang === 'zh-tw' ? 'zh_TW' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'zh-tw' ? 'en_US' : 'zh_TW'} />
  </head>
  <body class="landing-page">
    <a class="skip-link" href="#main">{copy.skipLink}</a>

    <div class="ambient-backdrop" aria-hidden="true">
      <div class="ambient-orb ambient-orb-grass"></div>
      <div class="ambient-orb ambient-orb-cyan"></div>
      <div class="voxel-grid-plane"></div>
      <canvas id="voxel-canvas" class="voxel-canvas"></canvas>
    </div>

    <header class="site-header" data-header>
      <div class="container header-inner">
        <a href={pageHref(homePath)} class="brand">
          <img class="brand-logo" src={logoDark.src} alt="" width="34" height="34" />
          <span class="brand-name">{PRODUCT_META.name}</span>
        </a>

        <button
          class="menu-toggle"
          type="button"
          aria-controls="site-navigation"
          aria-expanded="false"
          data-open-label={copy.menuOpen}
          data-close-label={copy.menuClose}
          hidden
        >
          <svg class="menu-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path class="menu-lines" d="M4 7h16M4 12h16M4 17h16" />
            <path class="menu-close" d="m6 6 12 12M18 6 6 18" />
          </svg>
          <span class="menu-label">{copy.menuOpen}</span>
        </button>

        <nav id="site-navigation" class="site-nav" aria-label={copy.navigationLabel} data-open="false">
          <a href={pageHref(copy.docsHomeHref)}>{copy.navDocs}</a>
          <a href={pageHref(copy.agentsHref)}>{copy.navAgents}</a>
          <a href={PRODUCT_META.repoUrl}>GitHub</a>
          <a href={pageHref(copy.switchLangHref)} hreflang={alternateLang} lang={alternateLang} class="nav-lang">
            {copy.switchLangLabel}
          </a>
          <a href={PRODUCT_META.releasesUrl} class="nav-cta">{copy.navDownload}</a>
        </nav>
      </div>
    </header>

    <main id="main" tabindex="-1">
      <LandingHero {copy} {pageHref} />
      <LandingFeatures {copy} {pageHref} />

      <section class="cta-section" aria-labelledby="cta-title">
        <div class="container">
          <div class="cta-dock" data-spotlight data-reveal>
            <img class="cta-emblem" src={logoDark.src} alt="" width="56" height="56" />
            <h2 id="cta-title" class="cta-title">{copy.ctaTitle}</h2>
            <p class="cta-subtitle">{copy.ctaSubtitle}</p>
            <div class="cta-actions">
              <a href={PRODUCT_META.releasesUrl} class="btn btn-primary">
                <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M12 3v12m0 0-4.5-4.5M12 15l4.5-4.5M4 19h16" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span>{copy.ctaPrimary}</span>
              </a>
              <a href={pageHref(copy.gettingStartedHref)} class="btn btn-secondary">{copy.ctaQuickstart}</a>
              <a href={pageHref(copy.agentsHref)} class="btn btn-ghost">{copy.ctaAgents}</a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div class="footer-left">
          <span class="footer-brand">{PRODUCT_META.name}</span>
          <p class="footer-note">{copy.footerNote}</p>
        </div>
        <nav class="footer-links" aria-label={copy.navigationLabel}>
          <a href={pageHref(copy.docsHomeHref)}>{copy.navDocs}</a>
          <a href={pageHref(copy.agentsHref)}>{copy.navAgents}</a>
          <a href={PRODUCT_META.repoUrl}>GitHub</a>
          <a href={pageHref(copy.switchLangHref)} hreflang={alternateLang} lang={alternateLang}>
            {copy.switchLangLabel}
          </a>
        </nav>
      </div>
    </footer>

    <script>
      import './landing-interactions';
    </script>
  </body>
</html>
