---
import '../styles/landing.css';
import { LANDING_COPY } from '../data/landing-i18n';
import { PRODUCT_META, type LocaleKey } from '../data/cli-surface';

interface Props {
  lang: LocaleKey;
}

const { lang } = Astro.props;
const copy = LANDING_COPY[lang] ?? LANDING_COPY.en;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pageHref = (path: string) => base + path;
const homePath = lang === 'zh-tw' ? '/zh-tw/' : '/';
const alternateLang = lang === 'zh-tw' ? 'en' : 'zh-TW';
const siteUrl = Astro.site ?? Astro.url;
const absoluteHref = (path: string) => new URL(pageHref(path), siteUrl).href;
const title = PRODUCT_META.name + ' — ' + copy.pageTitle;
---

<!doctype html>
<html lang={copy.langAttr} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#06090f" />
    <title>{title}</title>
    <meta name="description" content={copy.heroSubtitle} />
    <link rel="icon" type="image/svg+xml" href={pageHref('/favicon.svg')} />
    <link rel="canonical" href={absoluteHref(homePath)} />
    <link rel="alternate" hreflang="en" href={absoluteHref('/')} />
    <link rel="alternate" hreflang="zh-TW" href={absoluteHref('/zh-tw/')} />
    <link rel="alternate" hreflang="x-default" href={absoluteHref('/')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={PRODUCT_META.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={copy.heroSubtitle} />
    <meta property="og:url" content={absoluteHref(homePath)} />
    <meta property="og:locale" content={lang === 'zh-tw' ? 'zh_TW' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'zh-tw' ? 'en_US' : 'zh_TW'} />
  </head>
  <body class="landing-page">
    <a class="skip-link" href="#main">{copy.skipLink}</a>

    <div class="ambient-backdrop" aria-hidden="true">
      <div class="ambient-orb ambient-orb-grass"></div>
      <div class="ambient-orb ambient-orb-cyan"></div>
      <div class="voxel-grid-plane"></div>
      <canvas id="voxel-canvas" class="voxel-canvas"></canvas>
    </div>

    <header class="site-header" data-header>
      <div class="container header-inner">
        <a href={pageHref(homePath)} class="brand">
          <img class="brand-logo" src={pageHref('/favicon.svg')} alt="" width="34" height="34" />
          <span class="brand-name">{PRODUCT_META.name}</span>
        </a>

        <button
          class="menu-toggle"
          type="button"
          aria-controls="site-navigation"
          aria-expanded="false"
          data-open-label={copy.menuOpen}
          data-close-label={copy.menuClose}
          hidden
        >
          <svg class="menu-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path class="menu-lines" d="M4 7h16M4 12h16M4 17h16" />
            <path class="menu-close" d="m6 6 12 12M18 6 6 18" />
          </svg>
          <span class="menu-label">{copy.menuOpen}</span>
        </button>

        <nav id="site-navigation" class="site-nav" aria-label={copy.navigationLabel} data-open="false">
          <a href={pageHref(copy.docsHomeHref)}>{copy.navDocs}</a>
          <a href={pageHref(copy.agentsHref)}>{copy.navAgents}</a>
          <a href={PRODUCT_META.repoUrl}>GitHub</a>
          <a href={pageHref(copy.switchLangHref)} hreflang={alternateLang} lang={alternateLang} class="nav-lang">
            {copy.switchLangLabel}
          </a>
          <a href={PRODUCT_META.releasesUrl} class="nav-cta">{copy.navDownload}</a>
        </nav>
      </div>
    </header>

    <main id="main" tabindex="-1">
      <section class="hero" aria-labelledby="hero-title">
        <div class="container hero-layout">
          <div class="hero-copy">
            <h1 id="hero-title" class="hero-title">
              <span class="hero-line hero-line-1">{copy.heroTitlePlain}</span>
              <span class="hero-line hero-line-2 hero-gradient">{copy.heroTitleAccent}</span>
            </h1>
            <p class="hero-subtitle">{copy.heroSubtitle}</p>
            <div class="hero-actions">
              <a href={PRODUCT_META.releasesUrl} class="btn btn-primary">
                <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M12 3v12m0 0-4.5-4.5M12 15l4.5-4.5M4 19h16" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span>{copy.ctaDownload}</span>
              </a>
              <a href={pageHref(copy.docsHomeHref)} class="btn btn-secondary">
                <span>{copy.ctaDocs}</span>
                <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true">
                  <path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            </div>
          </div>

          <div class="stage-shell" data-spotlight aria-label={copy.stageAriaLabel}>
            <div class="stage-toolbar">
              <div class="stage-tabs" role="tablist" aria-label={copy.stageAriaLabel}>
                <span class="stage-tab-pill" aria-hidden="true"></span>
                {copy.heroScenes.map((scene, index) => (
                  <button
                    type="button"
                    role="tab"
                    class="stage-tab"
                    id={'stage-tab-' + scene.id}
                    data-scene={scene.id}
                    aria-selected={index === 0 ? 'true' : 'false'}
                    aria-controls={'stage-panel-' + scene.id}
                    tabindex={index === 0 ? 0 : -1}
                  >
                    {scene.label}
                  </button>
                ))}
              </div>
              <button
                type="button"
                class="locale-flip-btn"
                id="hero-translate-toggle"
                data-mode="translated"
                data-label-original={copy.heroTranslate.toggleOriginal}
                data-label-translated={copy.heroTranslate.toggleTranslated}
                aria-pressed="true"
              >
                <span class="flip-dot" aria-hidden="true"></span>
                <span class="flip-text">{copy.heroTranslate.toggleTranslated}</span>
              </button>
            </div>

            <div class="stage-viewport">
              {/* Scene 1: Translate Map */}
              <div
                class="stage-panel"
                id="stage-panel-translate"
                role="tabpanel"
                aria-labelledby="stage-tab-translate"
                data-scene-panel="translate"
                data-lang-state="translated"
              >
                <div class="stage-pane stage-pane-world">
                  <div class="pane-caption">{copy.heroScenes[0].worldLabel}</div>

                  <div class="slot-card slot-accent-grass" aria-label={copy.heroTranslate.signHeader}>
                    <div class="slot-card-head">
                      <svg class="slot-card-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                        <rect x="2" y="3" width="12" height="7" rx="1.5" />
                        <path d="M8 10v4M5 6.5h6" stroke-linecap="round" />
                      </svg>
                      <span class="slot-card-meta">{copy.heroTranslate.signHeader}</span>
                    </div>
                    <div class="slot-card-stack">
                      <div class="slot-layer mc-layer-en">
                        {copy.heroTranslate.signOriginal.map((line, i) => (
                          <span class={i === 0 ? 'slot-title' : 'slot-line'}>{line}</span>
                        ))}
                      </div>
                      <div class="slot-layer mc-layer-zh">
                        {copy.heroTranslate.signTranslated.map((line, i) => (
                          <span class={i === 0 ? 'slot-title' : 'slot-line'}>{line}</span>
                        ))}
                      </div>
                    </div>
                  </div>

                  <div class="slot-card slot-accent-cyan" aria-label={copy.heroTranslate.itemHeader}>
                    <div class="slot-card-head">
                      <svg class="slot-card-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                        <path d="M8 2.2 13 5.2v5.6L8 13.8 3 10.8V5.2L8 2.2Z" stroke-linejoin="round" />
                        <path d="M8 8v5.8M8 8l5-2.8M8 8 3 5.2" stroke-linecap="round" />
                      </svg>
                      <span class="slot-card-meta">{copy.heroTranslate.itemHeader}</span>
                    </div>
                    <div class="slot-item-name">
                      <span class="mc-layer-en">{copy.heroTranslate.itemNameOriginal}</span>
                      <span class="mc-layer-zh">{copy.heroTranslate.itemNameTranslated}</span>
                    </div>
                    <div class="slot-item-lore">
                      <span class="mc-layer-en">{copy.heroTranslate.itemLoreOriginal}</span>
                      <span class="mc-layer-zh">{copy.heroTranslate.itemLoreTranslated}</span>
                    </div>
                  </div>
                </div>

                <div class="stage-bridge" aria-hidden="true">
                  <svg class="bridge-svg" viewBox="0 0 88 180" fill="none" preserveAspectRatio="none">
                    <defs>
                      <linearGradient id="bridge-grad-1" x1="0" y1="0" x2="88" y2="0" gradientUnits="userSpaceOnUse">
                        <stop offset="0%" stop-color="#6AA04C" />
                        <stop offset="100%" stop-color="#38BDF8" />
                      </linearGradient>
                    </defs>
                    <path class="bridge-track" d="M2 56 C 34 56, 44 90, 86 90" stroke="url(#bridge-grad-1)" stroke-width="1.5" />
                    <path class="bridge-track" d="M2 132 C 34 132, 44 90, 86 90" stroke="url(#bridge-grad-1)" stroke-width="1.5" />
                    <path class="bridge-pulse" d="M2 56 C 34 56, 44 90, 86 90" stroke="#7DD3FC" stroke-width="2.2" />
                    <path class="bridge-pulse bridge-pulse-delay" d="M2 132 C 34 132, 44 90, 86 90" stroke="#86EFAC" stroke-width="2.2" />
                  </svg>
                  <div class="bridge-chip">
                    <span class="bridge-glyph">&gt;_</span>
                  </div>
                </div>

                <div class="stage-pane stage-pane-output">
                  <div class="pane-caption">{copy.heroScenes[0].outputLabel}</div>
                  <div class="stage-code" role="region" aria-label={copy.heroScenes[0].outputLabel}>
                    <div class="code-line"><span class="tok-brace">&#123;</span></div>
                    <div class="code-line code-indent"><span class="tok-key">"locale"</span><span class="tok-punct">: </span><span class="tok-str tok-swap-en">"{copy.heroTranslate.jsonLocaleOriginal}"</span><span class="tok-str tok-swap-zh">"{copy.heroTranslate.jsonLocaleTranslated}"</span><span class="tok-punct">,</span></div>
                    <div class="code-line code-indent"><span class="tok-key">"sign"</span><span class="tok-punct">: </span><span class="tok-str tok-swap-en">"{copy.heroTranslate.signOriginal[0]}"</span><span class="tok-str tok-swap-zh">"{copy.heroTranslate.signTranslated[0]}"</span><span class="tok-punct">,</span></div>
                    <div class="code-line code-indent"><span class="tok-key">"item"</span><span class="tok-punct">: </span><span class="tok-str tok-swap-en">"{copy.heroTranslate.itemNameOriginal}"</span><span class="tok-str tok-swap-zh">"{copy.heroTranslate.itemNameTranslated}"</span><span class="tok-punct">,</span></div>
                    <div class="code-line code-indent"><span class="tok-key">"formatSafe"</span><span class="tok-punct">: </span><span class="tok-bool">true</span></div>
                    <div class="code-line"><span class="tok-brace">&#125;</span></div>
                  </div>
                </div>
              </div>

              {/* Scene 2: Inspect Save */}
              <div
                class="stage-panel"
                id="stage-panel-inspect"
                role="tabpanel"
                aria-labelledby="stage-tab-inspect"
                data-scene-panel="inspect"
                hidden
              >
                <div class="stage-pane stage-pane-world">
                  <div class="pane-caption">{copy.heroScenes[1].worldLabel}</div>
                  <div class="world-stack">
                    <div class="scan-beam" aria-hidden="true"></div>
                    {copy.heroInspect.layers.map((layer, idx) => (
                      <div class={'world-layer world-layer-' + idx}>
                        <span class="world-layer-dot" aria-hidden="true"></span>
                        <div class="world-layer-text">
                          <span class="world-layer-file">{layer.file}</span>
                          <span class="world-layer-detail">{layer.detail}</span>
                        </div>
                      </div>
                    ))}
                  </div>
                </div>

                <div class="stage-bridge" aria-hidden="true">
                  <svg class="bridge-svg" viewBox="0 0 88 180" fill="none" preserveAspectRatio="none">
                    <path class="bridge-track" d="M2 90 H 86" stroke="#38BDF8" stroke-width="1.5" />
                    <path class="bridge-pulse" d="M2 90 H 86" stroke="#7DD3FC" stroke-width="2.4" />
                  </svg>
                  <div class="bridge-chip">
                    <span class="bridge-glyph">&#123; : &#125;</span>
                  </div>
                </div>

                <div class="stage-pane stage-pane-output">
                  <div class="pane-caption">{copy.heroScenes[1].outputLabel}</div>
                  <div class="stage-code" role="region" aria-label={copy.heroScenes[1].outputLabel}>
                    <div class="code-line"><span class="tok-brace">&#123;</span></div>
                    {copy.heroInspect.jsonFields.map((field, idx) => (
                      <div class="code-line code-indent">
                        <span class="tok-key">"{field.key}"</span><span class="tok-punct">: </span><span class={field.type === 'str' ? 'tok-str' : 'tok-num'}>{field.val}</span>{idx < copy.heroInspect.jsonFields.length - 1 ? <span class="tok-punct">,</span> : ''}
                      </div>
                    ))}
                    <div class="code-line"><span class="tok-brace">&#125;</span></div>
                  </div>
                </div>
              </div>

              {/* Scene 3: Export Pack */}
              <div
                class="stage-panel"
                id="stage-panel-pack"
                role="tabpanel"
                aria-labelledby="stage-tab-pack"
                data-scene-panel="pack"
                hidden
              >
                <div class="stage-pane stage-pane-world">
                  <div class="pane-caption">{copy.heroScenes[2].worldLabel}</div>
                  <div class="pack-bundle">
                    <div class="pack-archive-head">
                      <svg class="pack-cube-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M12 2.5 20.5 7.4v9.2L12 21.5 3.5 16.6V7.4L12 2.5Z" stroke="#6AA04C" stroke-width="1.7" fill="rgba(106,160,76,0.14)" />
                        <path d="M12 12 20.5 7.4M12 12 3.5 7.4M12 12v9.5" stroke="#38BDF8" stroke-width="1.5" />
                      </svg>
                      <span class="pack-archive-name">{copy.heroPack.packName}</span>
                    </div>
                    <ul class="pack-entry-list" role="list">
                      {copy.heroPack.entries.map((entry) => (
                        <li class="pack-entry-item">
                          <span class="pack-entry-path">{entry.path}</span>
                          <span class="pack-entry-tag">{entry.tag}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>

                <div class="stage-bridge" aria-hidden="true">
                  <svg class="bridge-svg" viewBox="0 0 88 180" fill="none" preserveAspectRatio="none">
                    <path class="bridge-track" d="M2 90 H 86" stroke="#6AA04C" stroke-width="1.5" />
                    <path class="bridge-pulse" d="M2 90 H 86" stroke="#86EFAC" stroke-width="2.4" />
                  </svg>
                  <div class="bridge-chip">
                    <span class="bridge-glyph">.zip</span>
                  </div>
                </div>

                <div class="stage-pane stage-pane-output">
                  <div class="pane-caption">{copy.heroScenes[2].outputLabel}</div>
                  <div class="stage-code" role="region" aria-label={copy.heroScenes[2].outputLabel}>
                    <div class="code-line"><span class="tok-brace">&#123;</span></div>
                    {copy.heroPack.jsonFields.map((field, idx) => (
                      <div class="code-line code-indent">
                        <span class="tok-key">"{field.key}"</span><span class="tok-punct">: </span><span class={field.type === 'str' ? 'tok-str' : field.val === 'false' ? 'tok-bool' : 'tok-num'}>{field.val}</span>{idx < copy.heroPack.jsonFields.length - 1 ? <span class="tok-punct">,</span> : ''}
                      </div>
                    ))}
                    <div class="code-line"><span class="tok-brace">&#125;</span></div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="bento-section" aria-labelledby="bento-title">
        <div class="container">
          <h2 id="bento-title" class="section-title" data-reveal>{copy.bentoTitle}</h2>

          <div class="bento-grid">
            {/* Card 1 (Wide): Live Map Translation */}
            <article class="bento-card bento-wide" data-spotlight data-tilt data-reveal>
              <div class="bento-visual visual-translate" data-bento-lang="zh">
                <div class="mini-switch-bar">
                  <div class="mini-progress-wrap">
                    <div class="mini-progress-bar">
                      <span class="mini-progress-fill"></span>
                    </div>
                    <span class="mini-progress-text">{copy.bentoTranslate.progressLabel}</span>
                  </div>
                  <div class="segmented-mini" role="group" aria-label={copy.bentoTranslate.title}>
                    <button type="button" class="seg-btn" data-set-bento-lang="en" aria-pressed="false">
                      {copy.bentoTranslate.btnOriginal}
                    </button>
                    <button type="button" class="seg-btn is-active" data-set-bento-lang="zh" aria-pressed="true">
                      {copy.bentoTranslate.btnTranslated}
                    </button>
                  </div>
                </div>

                <div class="translate-showcase">
                  <div class="slot-card slot-card-compact slot-accent-grass">
                    <div class="slot-card-head">
                      <svg class="slot-card-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                        <rect x="2" y="3" width="12" height="7" rx="1.5" />
                        <path d="M8 10v4M5 6.5h6" stroke-linecap="round" />
                      </svg>
                      <span class="slot-card-meta">{copy.bentoTranslate.signMeta}</span>
                    </div>
                    <div class="slot-card-stack">
                      <div class="slot-layer b-en">
                        {copy.bentoTranslate.signOriginal.map((line, i) => (
                          <span class={i === 0 ? 'slot-title' : 'slot-line'}>{line}</span>
                        ))}
                      </div>
                      <div class="slot-layer b-zh">
                        {copy.bentoTranslate.signTranslated.map((line, i) => (
                          <span class={i === 0 ? 'slot-title' : 'slot-line'}>{line}</span>
                        ))}
                      </div>
                    </div>
                  </div>

                  <div class="slot-card slot-card-compact slot-accent-cyan">
                    <div class="slot-card-head">
                      <svg class="slot-card-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                        <path d="M3 3.2A1.2 1.2 0 0 1 4.2 2h7.6A1.2 1.2 0 0 1 13 3.2v9.6a1.2 1.2 0 0 1-1.2 1.2H4.2A1.2 1.2 0 0 1 3 12.8V3.2Z" />
                        <path d="M5.5 5.5h5M5.5 8h5M5.5 10.5h3.2" stroke-linecap="round" />
                      </svg>
                      <span class="slot-card-meta b-en">{copy.bentoTranslate.bookTitleOriginal}</span>
                      <span class="slot-card-meta b-zh">{copy.bentoTranslate.bookTitleTranslated}</span>
                    </div>
                    <p class="slot-prose">
                      <span class="b-en">{copy.bentoTranslate.bookLineOriginal}</span>
                      <span class="b-zh">{copy.bentoTranslate.bookLineTranslated}</span>
                    </p>
                  </div>
                </div>
              </div>

              <div class="bento-body">
                <h3>{copy.bentoTranslate.title}</h3>
                <p>{copy.bentoTranslate.description}</p>
                <a class="card-link" href={pageHref(copy.bentoTranslate.href)}>
                  <span>{copy.bentoTranslate.linkLabel}</span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </a>
              </div>
            </article>

            {/* Card 2 (Narrow): Interactive Read-Only NBT Tree */}
            <article class="bento-card bento-narrow" data-spotlight data-tilt data-reveal>
              <div class="bento-visual visual-tree">
                <div class="nbt-tree-root">
                  <span class="nbt-root-dot" aria-hidden="true"></span>
                  <span>{copy.bentoInspect.rootLabel}</span>
                </div>
                <div class="nbt-branches">
                  {copy.bentoInspect.nodes.map((node, index) => (
                    <div class="nbt-branch" data-tree-branch data-open={index === 0 ? 'true' : 'false'}>
                      <button
                        type="button"
                        class="nbt-branch-toggle"
                        aria-expanded={index === 0 ? 'true' : 'false'}
                      >
                        <svg class="nbt-chevron" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                          <path d="m6 4 4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                        <span class="nbt-key">{node.key}</span>
                        <span class="nbt-type nbt-type-compound">{node.type}</span>
                      </button>
                      <div class="nbt-children">
                        {node.children?.map((child) => (
                          <div class="nbt-leaf">
                            <span class="nbt-leaf-key">{child.key}</span>
                            <span class="nbt-leaf-val">{child.value}</span>
                            <span class={'nbt-type ' + (child.type === 'Int' ? 'nbt-type-int' : 'nbt-type-str')}>
                              {child.type}
                            </span>
                          </div>
                        ))}
                      </div>
                    </div>
                  ))}
                </div>
              </div>

              <div class="bento-body">
                <h3>{copy.bentoInspect.title}</h3>
                <p>{copy.bentoInspect.description}</p>
                <a class="card-link" href={pageHref(copy.bentoInspect.href)}>
                  <span>{copy.bentoInspect.linkLabel}</span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </a>
              </div>
            </article>

            {/* Card 3 (Narrow): Resource Pack Mode Morph */}
            <article class="bento-card bento-narrow" data-spotlight data-tilt data-reveal>
              <div class="bento-visual visual-pack" data-pack-mode="zip">
                <div class="segmented-mini segmented-pack" role="group" aria-label={copy.bentoPack.title}>
                  <button type="button" class="seg-btn" data-set-pack-mode="direct" aria-pressed="false">
                    {copy.bentoPack.modeDirectLabel}
                  </button>
                  <button type="button" class="seg-btn is-active" data-set-pack-mode="zip" aria-pressed="true">
                    {copy.bentoPack.modeZipLabel}
                  </button>
                </div>

                <div class="pack-morph-list">
                  <div class="pack-mode-group pack-mode-direct">
                    {copy.bentoPack.directFiles.map((file) => (
                      <div class="pack-row">
                        <span class="pack-row-indicator pack-ind-grass" aria-hidden="true"></span>
                        <div class="pack-row-copy">
                          <span class="pack-row-path">{file.path}</span>
                          <span class="pack-row-note">{file.note}</span>
                        </div>
                      </div>
                    ))}
                  </div>
                  <div class="pack-mode-group pack-mode-zip">
                    {copy.bentoPack.zipFiles.map((file) => (
                      <div class="pack-row">
                        <span class="pack-row-indicator pack-ind-cyan" aria-hidden="true"></span>
                        <div class="pack-row-copy">
                          <span class="pack-row-path">{file.path}</span>
                          <span class="pack-row-note">{file.note}</span>
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              </div>

              <div class="bento-body">
                <h3>{copy.bentoPack.title}</h3>
                <p>{copy.bentoPack.description}</p>
                <a class="card-link" href={pageHref(copy.bentoPack.href)}>
                  <span>{copy.bentoPack.linkLabel}</span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </a>
              </div>
            </article>

            {/* Card 4 (Wide): Safe Edit & Rollback Timeline */}
            <article class="bento-card bento-wide" data-spotlight data-tilt data-reveal>
              <div class="bento-visual visual-safety" data-active-step="0">
                <div class="safety-track" role="tablist" aria-label={copy.bentoSafe.title}>
                  <div class="safety-rail" aria-hidden="true">
                    <span class="safety-rail-pulse"></span>
                  </div>
                  {copy.bentoSafe.checkpoints.map((cp, index) => (
                    <button
                      type="button"
                      role="tab"
                      class={'safety-node' + (index === 0 ? ' is-active' : '')}
                      data-safety-step={index}
                      aria-selected={index === 0 ? 'true' : 'false'}
                    >
                      <span class="safety-node-dot" aria-hidden="true">{index + 1}</span>
                      <span class="safety-node-label">{cp.label}</span>
                    </button>
                  ))}
                </div>

                <div class="safety-readout">
                  {copy.bentoSafe.checkpoints.map((cp, index) => (
                    <div
                      class={'safety-detail' + (index === 0 ? ' is-active' : '')}
                      data-safety-detail={index}
                    >
                      <span class="safety-status">{cp.status}</span>
                      <p class="safety-text">{cp.detail}</p>
                    </div>
                  ))}
                </div>
              </div>

              <div class="bento-body">
                <h3>{copy.bentoSafe.title}</h3>
                <p>{copy.bentoSafe.description}</p>
                <a class="card-link" href={pageHref(copy.bentoSafe.href)}>
                  <span>{copy.bentoSafe.linkLabel}</span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </a>
              </div>
            </article>
          </div>
        </div>
      </section>

      <section class="cta-section" aria-labelledby="cta-title">
        <div class="container">
          <div class="cta-dock" data-spotlight data-reveal>
            <img class="cta-emblem" src={pageHref('/favicon.svg')} alt="" width="56" height="56" />
            <h2 id="cta-title" class="cta-title">{copy.ctaTitle}</h2>
            <p class="cta-subtitle">{copy.ctaSubtitle}</p>
            <div class="cta-actions">
              <a href={PRODUCT_META.releasesUrl} class="btn btn-primary">
                <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M12 3v12m0 0-4.5-4.5M12 15l4.5-4.5M4 19h16" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span>{copy.ctaPrimary}</span>
              </a>
              <a href={pageHref(copy.gettingStartedHref)} class="btn btn-secondary">{copy.ctaQuickstart}</a>
              <a href={pageHref(copy.agentsHref)} class="btn btn-ghost">{copy.ctaAgents}</a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div class="footer-left">
          <span class="footer-brand">{PRODUCT_META.name}</span>
          <p class="footer-note">{copy.footerNote}</p>
        </div>
        <nav class="footer-links" aria-label={copy.navigationLabel}>
          <a href={pageHref(copy.docsHomeHref)}>{copy.navDocs}</a>
          <a href={pageHref(copy.agentsHref)}>{copy.navAgents}</a>
          <a href={PRODUCT_META.repoUrl}>GitHub</a>
          <a href={pageHref(copy.switchLangHref)} hreflang={alternateLang} lang={alternateLang}>
            {copy.switchLangLabel}
          </a>
        </nav>
      </div>
    </footer>

    <script>
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      document.documentElement.dataset.enhanced = 'true';

      // 1. Sticky glass header elevation on scroll
      const header = document.querySelector<HTMLElement>('[data-header]');
      if (header) {
        const updateHeader = () => {
          header.dataset.scrolled = window.scrollY > 12 ? 'true' : 'false';
        };
        updateHeader();
        window.addEventListener('scroll', updateHeader, { passive: true });
      }

      // 2. Mobile navigation drawer
      const menuToggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const navigation = document.querySelector<HTMLElement>('.site-nav');
      const mobile = window.matchMedia('(max-width: 760px)');
      if (menuToggle && navigation) {
        const menuLabel = menuToggle.querySelector<HTMLElement>('.menu-label');
        const setMenu = (open: boolean) => {
          menuToggle.setAttribute('aria-expanded', String(open));
          navigation.dataset.open = String(open);
          if (menuLabel) {
            menuLabel.textContent = (open ? menuToggle.dataset.closeLabel : menuToggle.dataset.openLabel) ?? '';
          }
        };
        menuToggle.addEventListener('click', () => setMenu(menuToggle.getAttribute('aria-expanded') !== 'true'));
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && mobile.matches && navigation.dataset.open === 'true') {
            setMenu(false);
            menuToggle.focus();
          }
        });
        document.addEventListener('click', (event) => {
          if (
            event.target instanceof Node &&
            mobile.matches &&
            !navigation.contains(event.target) &&
            !menuToggle.contains(event.target)
          ) {
            setMenu(false);
          }
        });
        mobile.addEventListener('change', () => setMenu(false));
        setMenu(false);
        menuToggle.hidden = false;
      }

      // 3. Hero Stage scene switcher + animated sliding pill
      const stageTabs = [...document.querySelectorAll<HTMLButtonElement>('.stage-tab')];
      const stagePanels = [...document.querySelectorAll<HTMLElement>('[data-scene-panel]')];
      const stagePill = document.querySelector<HTMLElement>('.stage-tab-pill');
      const heroToggleBtn = document.getElementById('hero-translate-toggle') as HTMLButtonElement | null;
      const translatePanel = document.getElementById('stage-panel-translate');

      const movePill = (activeBtn: HTMLButtonElement) => {
        if (!stagePill) return;
        stagePill.style.width = `${activeBtn.offsetWidth}px`;
        stagePill.style.transform = `translateX(${activeBtn.offsetLeft - 4}px)`;
      };

      const selectScene = (index: number) => {
        stageTabs.forEach((tab, i) => {
          const active = i === index;
          tab.setAttribute('aria-selected', String(active));
          tab.tabIndex = active ? 0 : -1;
          const panel = stagePanels[i];
          if (panel) {
            panel.hidden = !active;
            if (active) {
              panel.classList.remove('is-entering');
              void panel.offsetWidth;
              panel.classList.add('is-entering');
            }
          }
        });
        const currentTab = stageTabs[index];
        if (currentTab) {
          movePill(currentTab);
          if (heroToggleBtn) {
            heroToggleBtn.hidden = currentTab.dataset.scene !== 'translate';
          }
        }
      };

      if (stageTabs.length) {
        stageTabs.forEach((tab, index) => {
          tab.addEventListener('click', () => selectScene(index));
          tab.addEventListener('keydown', (event) => {
            let next: number;
            switch (event.key) {
              case 'ArrowRight': next = (index + 1) % stageTabs.length; break;
              case 'ArrowLeft': next = (index + stageTabs.length - 1) % stageTabs.length; break;
              case 'Home': next = 0; break;
              case 'End': next = stageTabs.length - 1; break;
              default: return;
            }
            event.preventDefault();
            selectScene(next);
            stageTabs[next].focus();
          });
        });
        requestAnimationFrame(() => selectScene(0));
        window.addEventListener('resize', () => {
          const activeIdx = stageTabs.findIndex((t) => t.getAttribute('aria-selected') === 'true');
          if (activeIdx >= 0) movePill(stageTabs[activeIdx]);
        });
      }

      // 4. Hero live EN <-> ZH morph toggle
      if (heroToggleBtn && translatePanel) {
        const flipText = heroToggleBtn.querySelector<HTMLElement>('.flip-text');
        let userToggledHero = false;
        const setHeroLang = (mode: 'original' | 'translated') => {
          heroToggleBtn.dataset.mode = mode;
          heroToggleBtn.setAttribute('aria-pressed', String(mode === 'translated'));
          translatePanel.dataset.langState = mode;
          if (flipText) {
            flipText.textContent =
              mode === 'translated'
                ? (heroToggleBtn.dataset.labelTranslated ?? '')
                : (heroToggleBtn.dataset.labelOriginal ?? '');
          }
        };
        heroToggleBtn.addEventListener('click', () => {
          userToggledHero = true;
          const next = heroToggleBtn.dataset.mode === 'translated' ? 'original' : 'translated';
          setHeroLang(next);
        });
        if (!prefersReducedMotion) {
          setHeroLang('original');
          window.setTimeout(() => {
            if (!userToggledHero) setHeroLang('translated');
          }, 1500);
        }
      }

      // 5. Bento Card 1: Live EN / ZH switch
      const bentoTranslateVisual = document.querySelector<HTMLElement>('[data-bento-lang]');
      if (bentoTranslateVisual) {
        const buttons = [...bentoTranslateVisual.querySelectorAll<HTMLButtonElement>('[data-set-bento-lang]')];
        buttons.forEach((btn) => {
          btn.addEventListener('click', () => {
            const langVal = btn.dataset.setBentoLang ?? 'zh';
            bentoTranslateVisual.dataset.bentoLang = langVal;
            buttons.forEach((b) => {
              const active = b === btn;
              b.classList.toggle('is-active', active);
              b.setAttribute('aria-pressed', String(active));
            });
          });
        });
      }

      // 6. Bento Card 2: Interactive NBT Tree expand/collapse
      document.querySelectorAll<HTMLElement>('[data-tree-branch]').forEach((branch) => {
        const btn = branch.querySelector<HTMLButtonElement>('.nbt-branch-toggle');
        if (!btn) return;
        btn.addEventListener('click', () => {
          const nextOpen = branch.dataset.open !== 'true';
          branch.dataset.open = String(nextOpen);
          btn.setAttribute('aria-expanded', String(nextOpen));
        });
      });

      // 7. Bento Card 3: Direct Map / Resource Pack .zip toggle
      const bentoPackVisual = document.querySelector<HTMLElement>('[data-pack-mode]');
      if (bentoPackVisual) {
        const buttons = [...bentoPackVisual.querySelectorAll<HTMLButtonElement>('[data-set-pack-mode]')];
        buttons.forEach((btn) => {
          btn.addEventListener('click', () => {
            const mode = btn.dataset.setPackMode ?? 'zip';
            bentoPackVisual.dataset.packMode = mode;
            buttons.forEach((b) => {
              const active = b === btn;
              b.classList.toggle('is-active', active);
              b.setAttribute('aria-pressed', String(active));
            });
          });
        });
      }

      // 8. Bento Card 4: Safety timeline checkpoints
      const safetyVisual = document.querySelector<HTMLElement>('[data-active-step]');
      if (safetyVisual) {
        const nodes = [...safetyVisual.querySelectorAll<HTMLButtonElement>('[data-safety-step]')];
        const details = [...safetyVisual.querySelectorAll<HTMLElement>('[data-safety-detail]')];
        const selectStep = (idx: number) => {
          safetyVisual.dataset.activeStep = String(idx);
          nodes.forEach((n, i) => {
            const active = i === idx;
            n.classList.toggle('is-active', active);
            n.setAttribute('aria-selected', String(active));
          });
          details.forEach((d, i) => d.classList.toggle('is-active', i === idx));
        };
        nodes.forEach((node, idx) => node.addEventListener('click', () => selectStep(idx)));
      }

      // 9. Cursor spotlight + responsive rAF-interpolated 3D tilt (zero transition-delay lag)
      const finePointer = window.matchMedia('(pointer: fine)').matches;
      if (finePointer && !prefersReducedMotion) {
        const clamp = (v: number, min: number, max: number) => Math.max(min, Math.min(max, v));
        document.querySelectorAll<HTMLElement>('[data-spotlight]').forEach((el) => {
          const hasTilt = el.hasAttribute('data-tilt');
          let targetRx = 0;
          let targetRy = 0;
          let targetScale = 1;
          let currentRx = 0;
          let currentRy = 0;
          let currentScale = 1;
          let hovering = false;
          let rafId = 0;

          const tickTilt = () => {
            const ease = hovering ? 0.3 : 0.16;
            currentRx += (targetRx - currentRx) * ease;
            currentRy += (targetRy - currentRy) * ease;
            currentScale += (targetScale - currentScale) * ease;

            el.style.setProperty('--rx', `${currentRx.toFixed(3)}deg`);
            el.style.setProperty('--ry', `${currentRy.toFixed(3)}deg`);
            el.style.setProperty('--card-scale', currentScale.toFixed(4));

            const settled =
              Math.abs(targetRx - currentRx) < 0.015 &&
              Math.abs(targetRy - currentRy) < 0.015 &&
              Math.abs(targetScale - currentScale) < 0.0005;

            if (settled) {
              currentRx = targetRx;
              currentRy = targetRy;
              currentScale = targetScale;
              el.style.setProperty('--rx', `${currentRx.toFixed(2)}deg`);
              el.style.setProperty('--ry', `${currentRy.toFixed(2)}deg`);
              el.style.setProperty('--card-scale', currentScale.toFixed(3));
              rafId = 0;
              if (!hovering) el.classList.remove('is-tilting');
              return;
            }
            rafId = requestAnimationFrame(tickTilt);
          };

          const startTiltLoop = () => {
            if (!rafId) rafId = requestAnimationFrame(tickTilt);
          };

          const updateFromEvent = (event: PointerEvent) => {
            const rect = el.getBoundingClientRect();
            const x = event.clientX - rect.left;
            const y = event.clientY - rect.top;
            el.style.setProperty('--mx', `${x.toFixed(1)}px`);
            el.style.setProperty('--my', `${y.toFixed(1)}px`);
            if (hasTilt && rect.width > 0 && rect.height > 0) {
              const nx = clamp(x / rect.width - 0.5, -0.5, 0.5);
              const ny = clamp(y / rect.height - 0.5, -0.5, 0.5);
              targetRx = -ny * 8.4;
              targetRy = nx * 8.4;
              startTiltLoop();
            }
          };

          el.addEventListener('pointerenter', (event) => {
            hovering = true;
            if (hasTilt) {
              el.classList.add('is-visible', 'is-revealed', 'is-tilting');
              targetScale = 1.008;
            }
            updateFromEvent(event);
          });

          el.addEventListener('pointermove', updateFromEvent);

          const resetTilt = () => {
            hovering = false;
            if (hasTilt) {
              targetRx = 0;
              targetRy = 0;
              targetScale = 1;
              startTiltLoop();
            }
          };

          el.addEventListener('pointerleave', resetTilt);
          el.addEventListener('pointercancel', resetTilt);
        });
      }

      // 10. Scroll-triggered stagger reveal (also reveals elements passed when jumping straight to bottom)
      const revealNodes = [...document.querySelectorAll<HTMLElement>('[data-reveal]')];
      if (!prefersReducedMotion && 'IntersectionObserver' in window && revealNodes.length) {
        const markVisible = (node: HTMLElement) => {
          if (node.classList.contains('is-visible')) return;
          node.classList.add('is-visible');
          const delayMs = parseFloat(node.style.getPropertyValue('--reveal-delay')) || 0;
          window.setTimeout(() => node.classList.add('is-revealed'), delayMs + 620);
        };
        const revealPassed = () => {
          const thresholdY = window.innerHeight + 80;
          revealNodes.forEach((node) => {
            if (!node.classList.contains('is-visible') && node.getBoundingClientRect().top <= thresholdY) {
              markVisible(node);
            }
          });
        };
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                markVisible(entry.target as HTMLElement);
                io.unobserve(entry.target);
              }
            });
            revealPassed();
          },
          { threshold: 0.08, rootMargin: '0px 0px -24px 0px' }
        );
        revealNodes.forEach((node, idx) => {
          node.style.setProperty('--reveal-delay', `${Math.min(idx * 60, 220)}ms`);
          io.observe(node);
        });
        let scrollScheduled = false;
        window.addEventListener(
          'scroll',
          () => {
            if (scrollScheduled) return;
            scrollScheduled = true;
            requestAnimationFrame(() => {
              scrollScheduled = false;
              revealPassed();
            });
          },
          { passive: true }
        );
        revealPassed();
      } else {
        revealNodes.forEach((node) => node.classList.add('is-visible', 'is-revealed'));
      }

      // 11. Lightweight floating digitized voxel pixels (Grass -> Cyan sparks)
      const canvas = document.getElementById('voxel-canvas') as HTMLCanvasElement | null;
      if (canvas && !prefersReducedMotion) {
        const ctx = canvas.getContext('2d');
        if (ctx) {
          type Voxel = { x: number; y: number; size: number; vy: number; alpha: number; color: string; phase: number };
          const colors = ['#6AA04C', '#4ADE80', '#38BDF8', '#7DD3FC'];
          let width = 0;
          let height = 0;
          let voxels: Voxel[] = [];
          let rafId = 0;
          let running = true;

          const resize = () => {
            const dpr = Math.min(window.devicePixelRatio || 1, 2);
            width = window.innerWidth;
            height = Math.min(window.innerHeight, 920);
            canvas.width = width * dpr;
            canvas.height = height * dpr;
            canvas.style.width = `${width}px`;
            canvas.style.height = `${height}px`;
            ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
            const count = Math.max(14, Math.min(34, Math.floor(width / 46)));
            voxels = Array.from({ length: count }, () => ({
              x: Math.random() * width,
              y: Math.random() * height,
              size: Math.random() > 0.55 ? 5 : 3.5,
              vy: 0.18 + Math.random() * 0.32,
              alpha: 0.14 + Math.random() * 0.28,
              color: colors[Math.floor(Math.random() * colors.length)],
              phase: Math.random() * Math.PI * 2,
            }));
          };

          const draw = (time: number) => {
            if (!running) return;
            ctx.clearRect(0, 0, width, height);
            for (const v of voxels) {
              v.y -= v.vy;
              if (v.y < -16) {
                v.y = height + 16;
                v.x = Math.random() * width;
              }
              const twinkle = 0.55 + 0.45 * Math.sin(time * 0.0014 + v.phase);
              const edgeFade = Math.min(1, v.y / 140, (height - v.y) / 140);
              ctx.globalAlpha = Math.max(0, v.alpha * twinkle * edgeFade);
              ctx.fillStyle = v.color;
              ctx.fillRect(Math.round(v.x), Math.round(v.y), v.size, v.size);
            }
            rafId = requestAnimationFrame(draw);
          };

          resize();
          window.addEventListener('resize', resize, { passive: true });
          document.addEventListener('visibilitychange', () => {
            running = !document.hidden;
            if (running) rafId = requestAnimationFrame(draw);
            else cancelAnimationFrame(rafId);
          });
          rafId = requestAnimationFrame(draw);
        }
      }
    </script>
  </body>
</html>
