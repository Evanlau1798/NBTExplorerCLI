---
import '../styles/landing.css';
import { LANDING_COPY } from '../data/landing-i18n';
import { PRODUCT_META, type LocaleKey } from '../data/cli-surface';

interface Props {
  lang: LocaleKey;
}

const { lang } = Astro.props;
const copy = LANDING_COPY[lang] ?? LANDING_COPY.en;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pageHref = (path: string) => base + path;
const homePath = lang === 'zh-tw' ? '/zh-tw/' : '/';
const alternateLang = lang === 'zh-tw' ? 'en' : 'zh-TW';
const siteUrl = Astro.site ?? Astro.url;
const absoluteHref = (path: string) => new URL(pageHref(path), siteUrl).href;
const title = PRODUCT_META.name + ' — ' + copy.pageTitle;
---

<!doctype html>
<html lang={copy.langAttr} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#080b10" />
    <title>{title}</title>
    <meta name="description" content={copy.heroSubtitle} />
    <link rel="icon" type="image/svg+xml" href={pageHref('/favicon.svg')} />
    <link rel="canonical" href={absoluteHref(homePath)} />
    <link rel="alternate" hreflang="en" href={absoluteHref('/')} />
    <link rel="alternate" hreflang="zh-TW" href={absoluteHref('/zh-tw/')} />
    <link rel="alternate" hreflang="x-default" href={absoluteHref('/')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={PRODUCT_META.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={copy.heroSubtitle} />
    <meta property="og:url" content={absoluteHref(homePath)} />
    <meta property="og:locale" content={lang === 'zh-tw' ? 'zh_TW' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'zh-tw' ? 'en_US' : 'zh_TW'} />
  </head>
  <body
    class="landing-page"
    data-copy-success={copy.copySuccess}
    data-copy-failure={copy.copyFailure}
    data-copy-label={copy.copyLabel}
    data-copied-label={copy.copiedLabel}
  >
    <a class="skip-link" href="#main">{copy.skipLink}</a>
    <header class="site-header">
      <div class="container header-inner">
        <a href={pageHref(homePath)} class="brand">
          <img class="brand-logo" src={pageHref('/favicon.svg')} alt="" width="32" height="32" />
          <span class="brand-name">{PRODUCT_META.name}</span>
        </a>
        <button
          class="menu-toggle"
          type="button"
          aria-controls="site-navigation"
          aria-expanded="false"
          data-open-label={copy.menuOpen}
          data-close-label={copy.menuClose}
          hidden
        >
          <svg class="menu-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
            <path class="menu-lines" d="M4 7h16M4 12h16M4 17h16" />
            <path class="menu-close" d="m6 6 12 12M18 6 6 18" />
          </svg>
          <span class="menu-label">{copy.menuOpen}</span>
        </button>
        <nav id="site-navigation" class="site-nav" aria-label={copy.navigationLabel} data-open="false">
          <a href="#features">{copy.navFeatures}</a>
          <a href="#workflow">{copy.navWorkflow}</a>
          <a href={pageHref(copy.docsHomeHref)}>{copy.navDocs}</a>
          <a href={PRODUCT_META.repoUrl}>GitHub</a>
          <a href={pageHref(copy.switchLangHref)} hreflang={alternateLang} lang={alternateLang}>{copy.switchLangLabel}</a>
        </nav>
      </div>
    </header>

    <main id="main" tabindex="-1">
      <section class="hero section" aria-labelledby="hero-title">
        <div class="container hero-grid">
          <div class="hero-copy">
            <p class="platform-badge"><span class="status-dot" aria-hidden="true"></span>{copy.badgeText}</p>
            <h1 id="hero-title" class="hero-title">
              {copy.heroLines.map((line) => <span class="hero-title-line">{line}</span>)}
            </h1>
            <p class="hero-description">{copy.heroSubtitle}</p>
            <div class="hero-actions">
              <a href={PRODUCT_META.releasesUrl} class="button button-primary">
                {copy.ctaDownload}
                <svg class="button-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <path d="M5 12h14M12 5l7 7-7 7" />
                </svg>
              </a>
              <a href={pageHref(copy.gettingStartedHref)} class="button button-secondary">{copy.ctaDocs}</a>
            </div>
            <p class="release-meta">v{PRODUCT_META.version} / Windows x64 / {copy.runtimeIncluded}</p>
          </div>

          <div class="terminal" aria-label={copy.terminalTitle}>
            <div class="terminal-chrome">
              <span class="terminal-title">PowerShell</span>
              <span>{PRODUCT_META.binary}</span>
            </div>
            <div class="terminal-tabs" role="tablist" aria-label={copy.terminalTitle} hidden>
              {copy.terminalTabs.map((tab, index) => (
                <button
                  type="button"
                  role="tab"
                  class="terminal-tab"
                  id={'terminal-tab-' + tab.id}
                  aria-selected={index === 0 ? 'true' : 'false'}
                  aria-controls={'terminal-panel-' + tab.id}
                  tabindex={index === 0 ? 0 : -1}
                >{tab.label}</button>
              ))}
            </div>
            {copy.terminalTabs.map((tab) => (
              <section class="terminal-panel" id={'terminal-panel-' + tab.id} aria-labelledby={'example-title-' + tab.id}>
                <h2 class="panel-heading" id={'example-title-' + tab.id}>{tab.label}</h2>
                <div class="command-head">
                  <span class="terminal-prompt" aria-hidden="true">PS &gt;</span>
                  <button
                    class="copy-button"
                    type="button"
                    data-copy-target={'example-command-' + tab.id}
                    aria-label={copy.copyCommandLabel + ': ' + tab.label}
                    hidden
                  ><span class="copy-label">{copy.copyLabel}</span></button>
                </div>
                <pre class="code-block terminal-command"><code id={'example-command-' + tab.id}>{tab.command}</code></pre>
                <p class="terminal-note">{tab.note}</p>
                <p class="response-label">{copy.responseLabel}</p>
                <pre class="code-block terminal-response"><code>{tab.output}</code></pre>
                <p class="terminal-status" data-tier={tab.tier}>{tab.status}</p>
              </section>
            ))}
            <p class="example-note">{copy.exampleNote}</p>
          </div>
        </div>
      </section>

      <div class="proof-band">
        <ul class="container proof-list" role="list">
          {copy.proofItems.map((item) => <li>{item}</li>)}
        </ul>
      </div>

      <section id="features" class="capabilities section" aria-labelledby="features-title">
        <div class="container">
          <div class="section-heading">
            <p class="eyebrow">{copy.featuresEyebrow}</p>
            <h2 id="features-title" class="section-title">{copy.featuresTitle}</h2>
            <p class="section-description">{copy.featuresSubtitle}</p>
          </div>
          <div class="capability-grid">
            {copy.features.map((feature) => (
              <article class="capability-card">
                <p class="capability-index">{feature.kicker}</p>
                <h3>{feature.title}</h3>
                <p class="card-description">{feature.description}</p>
                <p class="card-command">{feature.commands}</p>
                <a class="text-link" href={pageHref(feature.href)}>{feature.linkLabel}<span aria-hidden="true"> &rarr;</span></a>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="workflow" class="workflow section" aria-labelledby="workflow-title">
        <div class="container split-grid">
          <div class="section-copy">
            <p class="eyebrow">{copy.workflowEyebrow}</p>
            <h2 id="workflow-title" class="section-title">{copy.workflowTitle}</h2>
            <p class="section-description">{copy.workflowSubtitle}</p>
            <a class="text-link" href={pageHref(copy.commandsHref)}>{copy.workflowLink}<span aria-hidden="true"> &rarr;</span></a>
          </div>
          <div class="workflow-detail">
            <ol class="workflow-list">
              {copy.workflowSteps.map((step, index) => (
                <li class="workflow-step">
                  <span class="step-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                  <div class="step-body"><h3>{step.title}</h3><p>{step.body}</p></div>
                </li>
              ))}
            </ol>
            <p class="workflow-note">{copy.writeNote} <a href={pageHref(copy.safetyHref)}>{copy.safetyLink}</a></p>
          </div>
        </div>
      </section>

      <section id="get-started" class="quick-start section" aria-labelledby="install-title">
        <div class="container split-grid">
          <div class="section-copy">
            <p class="eyebrow">{copy.installEyebrow}</p>
            <h2 id="install-title" class="section-title">{copy.installTitle}</h2>
            <p class="section-description">{copy.installSubtitle}</p>
            <a href={PRODUCT_META.releasesUrl} class="button button-primary">
              {copy.ctaDownload}<span aria-hidden="true">&rarr;</span>
            </a>
            <a class="text-link" href={pageHref(copy.gettingStartedHref)}>{copy.installLink}<span aria-hidden="true"> &rarr;</span></a>
          </div>
          <ol class="install-steps">
            {copy.installSteps.map((step) => (
              <li class="install-step">
                <div class="install-step-heading">
                  <h3 class="step-title">{step.title}</h3>
                  <button
                    class="copy-button"
                    type="button"
                    data-copy-target={'install-command-' + step.id}
                    aria-label={copy.copyCommandLabel + ': ' + step.title}
                    hidden
                  ><span class="copy-label">{copy.copyLabel}</span></button>
                </div>
                <pre class="code-block install-code"><code id={'install-command-' + step.id}>{step.command}</code></pre>
                <p class="install-hint">{step.hint}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div>
          <p class="footer-brand">{PRODUCT_META.name}</p>
          <p class="footer-note">{copy.footerNote}</p>
        </div>
        <nav class="footer-links" aria-label={copy.navigationLabel}>
          <a href={pageHref(copy.docsHomeHref)}>{copy.navDocs}</a>
          <a href={PRODUCT_META.repoUrl}>GitHub</a>
          <a href={pageHref(copy.switchLangHref)} hreflang={alternateLang} lang={alternateLang}>{copy.switchLangLabel}</a>
        </nav>
      </div>
    </footer>
    <p id="copy-feedback" class="copy-feedback" role="status" aria-live="polite" aria-atomic="true"></p>

    <script>
      const tabList = document.querySelector<HTMLElement>('.terminal-tabs');
      const tabs = [...document.querySelectorAll<HTMLButtonElement>('.terminal-tab')];
      const panels = tabs.map((tab) => document.getElementById(tab.getAttribute('aria-controls') ?? ''));

      if (tabList && tabs.length && panels.every(Boolean)) {
        const selectTab = (selected: number) => {
          tabs.forEach((tab, index) => {
            const active = index === selected;
            tab.setAttribute('aria-selected', String(active));
            tab.tabIndex = active ? 0 : -1;
            const panel = panels[index]!;
            panel.hidden = !active;
            panel.setAttribute('role', 'tabpanel');
            panel.setAttribute('aria-labelledby', tab.id);
            panel.tabIndex = 0;
          });
        };
        tabs.forEach((tab, index) => {
          tab.addEventListener('click', () => selectTab(index));
          tab.addEventListener('keydown', (event) => {
            let next: number;
            switch (event.key) {
              case 'ArrowRight': next = (index + 1) % tabs.length; break;
              case 'ArrowLeft': next = (index + tabs.length - 1) % tabs.length; break;
              case 'Home': next = 0; break;
              case 'End': next = tabs.length - 1; break;
              default: return;
            }
            event.preventDefault();
            selectTab(next);
            tabs[next].focus();
          });
        });
        selectTab(0);
        tabList.hidden = false;
      }

      const menuToggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const navigation = document.querySelector<HTMLElement>('.site-nav');
      const mobile = window.matchMedia('(max-width: 760px)');

      if (menuToggle && navigation) {
        const menuLabel = menuToggle.querySelector<HTMLElement>('.menu-label');
        const setMenu = (open: boolean) => {
          menuToggle.setAttribute('aria-expanded', String(open));
          navigation.dataset.open = String(open);
          if (menuLabel) menuLabel.textContent = (open ? menuToggle.dataset.closeLabel : menuToggle.dataset.openLabel) ?? '';
        };
        menuToggle.addEventListener('click', () => setMenu(menuToggle.getAttribute('aria-expanded') !== 'true'));
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && mobile.matches && navigation.dataset.open === 'true') {
            setMenu(false);
            menuToggle.focus();
          }
        });
        document.addEventListener('click', (event) => {
          if (event.target instanceof Node && mobile.matches && !navigation.contains(event.target) && !menuToggle.contains(event.target)) {
            const restoreFocus = navigation.contains(document.activeElement);
            setMenu(false);
            if (restoreFocus) menuToggle.focus();
          }
        });
        navigation.addEventListener('click', (event) => {
          if (!(event.target instanceof Element)) return;
          const link = event.target.closest<HTMLAnchorElement>('a');
          if (!link || !mobile.matches) return;
          setMenu(false);
          if (link.hash && link.pathname === window.location.pathname) {
            const target = document.getElementById(link.hash.slice(1));
            if (target) {
              target.tabIndex = -1;
              target.focus({ preventScroll: true });
            }
          }
        });
        mobile.addEventListener('change', () => {
          const wasInMenu = navigation.contains(document.activeElement);
          const wasOnToggle = document.activeElement === menuToggle;
          setMenu(false);
          if (mobile.matches && wasInMenu) menuToggle.focus();
          if (!mobile.matches && wasOnToggle) navigation.querySelector<HTMLAnchorElement>('a')?.focus();
        });
        setMenu(false);
        menuToggle.hidden = false;
      }

      const feedback = document.getElementById('copy-feedback');
      const messages = document.body.dataset;
      let feedbackTimer: ReturnType<typeof setTimeout>;
      document.querySelectorAll<HTMLButtonElement>('[data-copy-target]').forEach((button) => {
        const code = document.getElementById(button.dataset.copyTarget ?? '');
        if (!code) return;
        const label = button.querySelector<HTMLElement>('.copy-label');
        let resetTimer: ReturnType<typeof setTimeout>;
        button.hidden = false;
        button.addEventListener('click', async () => {
          clearTimeout(resetTimer);
          clearTimeout(feedbackTimer);
          if (feedback) feedback.textContent = '';
          try {
            if (!navigator.clipboard?.writeText) throw new Error('Clipboard unavailable');
            await navigator.clipboard.writeText(code.textContent ?? '');
            if (label) label.textContent = messages.copiedLabel ?? '';
            if (feedback) feedback.textContent = messages.copySuccess ?? '';
          } catch {
            if (label) label.textContent = messages.copyLabel ?? '';
            if (feedback) feedback.textContent = messages.copyFailure ?? '';
          }
          resetTimer = setTimeout(() => {
            if (label) label.textContent = messages.copyLabel ?? '';
          }, 2000);
          feedbackTimer = setTimeout(() => {
            if (feedback) feedback.textContent = '';
          }, 6000);
        });
      });
      document.documentElement.dataset.enhanced = 'true';
    </script>
  </body>
</html>
