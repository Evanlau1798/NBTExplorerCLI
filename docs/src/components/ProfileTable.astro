---
import { SUPPORTED_PROFILES, type LocaleKey } from '../data/cli-surface';

interface Props {
  lang?: LocaleKey;
}

const { lang = 'en' } = Astro.props;
const headers =
  lang === 'zh-tw'
    ? {
        profile: '版本代號',
        dv: 'DataVersion',
        packFormat: '代表版本的資源包格式',
        layout: '維度目錄結構',
        items: '物品資料格式',
        text: '文字格式',
        pack: '資源包命名規則',
      }
    : {
        profile: 'Version Profile',
        dv: 'DataVersion',
        packFormat: 'Example Resource Pack Format',
        layout: 'Dimension Layout',
        items: 'Item Format',
        text: 'Text Format',
        pack: 'Pack Layout',
      };
---

<div class="nbt-table-wrap nbt-table-profile">
  <table>
    <thead>
      <tr>
        <th>{headers.profile}</th>
        <th>{headers.dv}</th>
        <th>{headers.packFormat}</th>
        <th>{headers.layout}</th>
        <th>{headers.items}</th>
        <th>{headers.text}</th>
        <th>{headers.pack}</th>
      </tr>
    </thead>
    <tbody>
      {
        SUPPORTED_PROFILES.map((row) => (
          <tr>
            <td>
              <code>{row.profile}</code>
            </td>
            <td>
              <code>{row.dataVersionRange}</code>
            </td>
            <td>
              <code>{row.packFormat ?? '—'}</code>
            </td>
            <td>
              <code>{row.layout}</code>
            </td>
            <td>
              <code>{row.itemSchema}</code>
            </td>
            <td>
              <code>{row.textSchema}</code>
            </td>
            <td>
              <code>{row.packLayout}</code>
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
