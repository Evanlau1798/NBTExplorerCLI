---
import { EXIT_CODES, type LocaleKey } from '../data/cli-surface';

interface Props {
  lang?: LocaleKey;
}

const { lang = 'en' } = Astro.props;
const headers =
  lang === 'zh-tw'
    ? { code: '退出碼', status: '狀態分類', meaning: '代表意義', action: '建議處理方式' }
    : { code: 'Exit Code', status: 'Category', meaning: 'Meaning', action: 'Recommended Action' };

const kindOf = (code: number) => {
  if (code === 0) return 'ok';
  if (code === 7 || code === 1) return 'danger';
  if (code === 8) return 'info';
  return 'warn';
};
---

<table>
  <thead>
    <tr>
      <th>{headers.code}</th>
      <th>{headers.status}</th>
      <th>{headers.meaning}</th>
      <th>{headers.action}</th>
    </tr>
  </thead>
  <tbody>
    {
      EXIT_CODES.map((row) => (
        <tr>
          <td>
            <span class="nbt-exit-code" data-kind={kindOf(row.code)}>{row.code}</span>
          </td>
          <td>
            <strong>{row.label[lang] ?? row.label.en}</strong>
          </td>
          <td>{row.meaning[lang] ?? row.meaning.en}</td>
          <td>{row.action[lang] ?? row.action.en}</td>
        </tr>
      ))
    }
  </tbody>
</table>
