---
import { SAFETY_LABELS, type LocaleKey, type SafetyTier } from '../data/cli-surface';

interface Props {
  tier: SafetyTier;
  lang?: LocaleKey;
  customDescription?: string;
}

const { tier, lang = 'en', customDescription } = Astro.props;
const labels = SAFETY_LABELS[lang] ?? SAFETY_LABELS.en;
const item = labels[tier];
---

<div class="nbt-safety-banner not-content" data-tier={tier}>
  <span class="nbt-safety-dot" aria-hidden="true"></span>
  <span class="nbt-safety-text">
    <strong>{item.badge}</strong>{customDescription ?? item.description}
  </span>
</div>
