---
import { PRODUCT_META } from '../data/cli-surface';
import { type LandingCopy } from '../data/landing-i18n';

interface Props {
  copy: LandingCopy;
  pageHref: (path: string) => string;
}

const { copy, pageHref } = Astro.props;
const defaultCmd = copy.heroScenes[0]?.cliCommand ?? 'nbtcli inspect .\\MyWorld';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero-layout">
    <div class="hero-copy">
      <div class="hero-eyebrow">
        <span class="eyebrow-dot" aria-hidden="true"></span>
        <span>{copy.heroEyebrow}</span>
      </div>

      <h1 id="hero-title" class="hero-title">
        <span class="hero-line hero-line-1">{copy.heroTitlePlain}</span>
        <span class="hero-line hero-line-2 hero-line-accent">{copy.heroTitleAccent}</span>
      </h1>

      <p class="hero-subtitle">{copy.heroSubtitle}</p>

      <div class="hero-actions">
        <a href={PRODUCT_META.releasesUrl} class="btn btn-primary">
          <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M12 3v12m0 0-4.5-4.5M12 15l4.5-4.5M4 19h16" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <span>{copy.ctaDownload}</span>
        </a>
        <a href={pageHref(copy.docsHomeHref)} class="btn btn-secondary">
          <span>{copy.ctaDocs}</span>
          <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true">
            <path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>

      <div class="hero-cli-bar" data-cli-bar>
        <span class="cli-prompt" aria-hidden="true">$</span>
        <code class="cli-code" id="hero-cli-code">{defaultCmd}</code>
        <button
          type="button"
          class="cli-copy-btn"
          id="hero-cli-copy"
          aria-label={copy.copyCmdLabel}
          data-copy-label={copy.copyCmdLabel}
          data-copied-label={copy.copiedCmdLabel}
        >
          <svg class="cli-icon cli-icon-copy" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <rect x="5.25" y="5.25" width="8.5" height="8.5" rx="1.5" />
            <path d="M10.75 5.25V3.5a1.25 1.25 0 0 0-1.25-1.25h-6A1.25 1.25 0 0 0 2.25 3.5v6a1.25 1.25 0 0 0 1.25 1.25h1.75" />
          </svg>
          <svg class="cli-icon cli-icon-check" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="m3.5 8.5 3 3 6-6.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <span class="cli-copy-text">{copy.copyCmdLabel}</span>
        </button>
      </div>
    </div>

    <div class="stage-shell" data-spotlight aria-label={copy.stageAriaLabel}>
      <div class="stage-toolbar">
        <div class="stage-tabs" role="tablist" aria-label={copy.stageAriaLabel}>
          <span class="stage-tab-pill" aria-hidden="true"></span>
          {copy.heroScenes.map((scene, index) => (
            <button
              type="button"
              role="tab"
              class="stage-tab"
              id={'stage-tab-' + scene.id}
              data-scene={scene.id}
              data-cli-cmd={scene.cliCommand}
              aria-selected={index === 0 ? 'true' : 'false'}
              aria-controls={'stage-panel-' + scene.id}
              tabindex={index === 0 ? 0 : -1}
            >
              {scene.label}
            </button>
          ))}
        </div>
        <button
          type="button"
          class="locale-flip-btn"
          id="hero-translate-toggle"
          data-mode="translated"
          data-label-original={copy.heroTranslate.toggleOriginal}
          data-label-translated={copy.heroTranslate.toggleTranslated}
          aria-pressed="true"
        >
          <span class="flip-dot" aria-hidden="true"></span>
          <span class="flip-text">{copy.heroTranslate.toggleTranslated}</span>
        </button>
      </div>

      <div class="stage-viewport">
        {/* Scene 1: Translate Map */}
        <div
          class="stage-panel"
          id="stage-panel-translate"
          role="tabpanel"
          aria-labelledby="stage-tab-translate"
          data-scene-panel="translate"
          data-lang-state="translated"
        >
          <div class="stage-pane stage-pane-world">
            <div class="pane-caption">{copy.heroScenes[0].worldLabel}</div>

            <div class="slot-card slot-accent-emerald" aria-label={copy.heroTranslate.signHeader}>
              <div class="slot-card-head">
                <svg class="slot-card-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <rect x="2" y="3" width="12" height="7" rx="1.5" />
                  <path d="M8 10v4M5 6.5h6" stroke-linecap="round" />
                </svg>
                <span class="slot-card-meta">{copy.heroTranslate.signHeader}</span>
              </div>
              <div class="slot-card-stack">
                <div class="slot-layer mc-layer-en">
                  {copy.heroTranslate.signOriginal.map((line, i) => (
                    <span class={i === 0 ? 'slot-title' : 'slot-line'}>{line}</span>
                  ))}
                </div>
                <div class="slot-layer mc-layer-zh">
                  {copy.heroTranslate.signTranslated.map((line, i) => (
                    <span class={i === 0 ? 'slot-title' : 'slot-line'}>{line}</span>
                  ))}
                </div>
              </div>
            </div>

            <div class="slot-card slot-accent-neutral" aria-label={copy.heroTranslate.itemHeader}>
              <div class="slot-card-head">
                <svg class="slot-card-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path d="M8 2.2 13 5.2v5.6L8 13.8 3 10.8V5.2L8 2.2Z" stroke-linejoin="round" />
                  <path d="M8 8v5.8M8 8l5-2.8M8 8 3 5.2" stroke-linecap="round" />
                </svg>
                <span class="slot-card-meta">{copy.heroTranslate.itemHeader}</span>
              </div>
              <div class="slot-item-name">
                <span class="mc-layer-en">{copy.heroTranslate.itemNameOriginal}</span>
                <span class="mc-layer-zh">{copy.heroTranslate.itemNameTranslated}</span>
              </div>
              <div class="slot-item-lore">
                <span class="mc-layer-en">{copy.heroTranslate.itemLoreOriginal}</span>
                <span class="mc-layer-zh">{copy.heroTranslate.itemLoreTranslated}</span>
              </div>
            </div>
          </div>

          <div class="stage-bridge" aria-hidden="true">
            <svg class="bridge-svg" viewBox="0 0 72 180" fill="none" preserveAspectRatio="none">
              <path class="bridge-track" d="M2 56 C 28 56, 36 90, 70 90" stroke="currentColor" stroke-width="1.2" />
              <path class="bridge-track" d="M2 132 C 28 132, 36 90, 70 90" stroke="currentColor" stroke-width="1.2" />
              <path class="bridge-pulse" d="M2 56 C 28 56, 36 90, 70 90" stroke="var(--accent)" stroke-width="1.6" />
              <path class="bridge-pulse bridge-pulse-delay" d="M2 132 C 28 132, 36 90, 70 90" stroke="var(--accent)" stroke-width="1.6" />
            </svg>
            <div class="bridge-chip">
              <span class="bridge-glyph">&gt;_</span>
            </div>
          </div>

          <div class="stage-pane stage-pane-output">
            <div class="pane-caption">{copy.heroScenes[0].outputLabel}</div>
            <div class="stage-code" role="region" aria-label={copy.heroScenes[0].outputLabel}>
              <div class="code-line"><span class="tok-brace">&#123;</span></div>
              <div class="code-line code-indent"><span class="tok-key">"locale"</span><span class="tok-punct">: </span><span class="tok-str tok-swap-en">"{copy.heroTranslate.jsonLocaleOriginal}"</span><span class="tok-str tok-swap-zh">"{copy.heroTranslate.jsonLocaleTranslated}"</span><span class="tok-punct">,</span></div>
              <div class="code-line code-indent"><span class="tok-key">"sign"</span><span class="tok-punct">: </span><span class="tok-str tok-swap-en">"{copy.heroTranslate.signOriginal[0]}"</span><span class="tok-str tok-swap-zh">"{copy.heroTranslate.signTranslated[0]}"</span><span class="tok-punct">,</span></div>
              <div class="code-line code-indent"><span class="tok-key">"item"</span><span class="tok-punct">: </span><span class="tok-str tok-swap-en">"{copy.heroTranslate.itemNameOriginal}"</span><span class="tok-str tok-swap-zh">"{copy.heroTranslate.itemNameTranslated}"</span><span class="tok-punct">,</span></div>
              <div class="code-line code-indent"><span class="tok-key">"formatSafe"</span><span class="tok-punct">: </span><span class="tok-bool">true</span></div>
              <div class="code-line"><span class="tok-brace">&#125;</span></div>
            </div>
          </div>
        </div>

        {/* Scene 2: Inspect Save */}
        <div
          class="stage-panel"
          id="stage-panel-inspect"
          role="tabpanel"
          aria-labelledby="stage-tab-inspect"
          data-scene-panel="inspect"
          hidden
        >
          <div class="stage-pane stage-pane-world">
            <div class="pane-caption">{copy.heroScenes[1].worldLabel}</div>
            <div class="world-stack">
              {copy.heroInspect.layers.map((layer, idx) => (
                <div class={'world-layer world-layer-' + idx}>
                  <span class="world-layer-dot" aria-hidden="true"></span>
                  <div class="world-layer-text">
                    <span class="world-layer-file">{layer.file}</span>
                    <span class="world-layer-detail">{layer.detail}</span>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <div class="stage-bridge" aria-hidden="true">
            <svg class="bridge-svg" viewBox="0 0 72 180" fill="none" preserveAspectRatio="none">
              <path class="bridge-track" d="M2 90 H 70" stroke="currentColor" stroke-width="1.2" />
              <path class="bridge-pulse" d="M2 90 H 70" stroke="var(--accent)" stroke-width="1.6" />
            </svg>
            <div class="bridge-chip">
              <span class="bridge-glyph">&#123; : &#125;</span>
            </div>
          </div>

          <div class="stage-pane stage-pane-output">
            <div class="pane-caption">{copy.heroScenes[1].outputLabel}</div>
            <div class="stage-code" role="region" aria-label={copy.heroScenes[1].outputLabel}>
              <div class="code-line"><span class="tok-brace">&#123;</span></div>
              {copy.heroInspect.jsonFields.map((field, idx) => (
                <div class="code-line code-indent">
                  <span class="tok-key">"{field.key}"</span><span class="tok-punct">: </span><span class={field.type === 'str' ? 'tok-str' : 'tok-num'}>{field.val}</span>{idx < copy.heroInspect.jsonFields.length - 1 ? <span class="tok-punct">,</span> : ''}
                </div>
              ))}
              <div class="code-line"><span class="tok-brace">&#125;</span></div>
            </div>
          </div>
        </div>

        {/* Scene 3: Export Pack */}
        <div
          class="stage-panel stage-panel-pack"
          id="stage-panel-pack"
          role="tabpanel"
          aria-labelledby="stage-tab-pack"
          data-scene-panel="pack"
          hidden
        >
          <div class="stage-pane stage-pane-world">
            <div class="pane-caption">{copy.heroScenes[2].worldLabel}</div>
            <div class="pack-bundle">
              <div class="pack-archive-head">
                <svg class="pack-cube-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M12 2.5 20.5 7.4v9.2L12 21.5 3.5 16.6V7.4L12 2.5Z" stroke="var(--accent)" stroke-width="1.6" fill="var(--accent-soft)" />
                  <path d="M12 12 20.5 7.4M12 12 3.5 7.4M12 12v9.5" stroke="currentColor" stroke-opacity="0.55" stroke-width="1.4" />
                </svg>
                <span class="pack-archive-name">{copy.heroPack.packName}</span>
              </div>
              <ul class="pack-entry-list" role="list">
                {copy.heroPack.entries.map((entry) => (
                  <li class="pack-entry-item">
                    <span class="pack-entry-path" title={entry.path}>{entry.path}</span>
                    <span class="pack-entry-tag">{entry.tag}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <div class="stage-bridge" aria-hidden="true">
            <svg class="bridge-svg" viewBox="0 0 72 180" fill="none" preserveAspectRatio="none">
              <path class="bridge-track" d="M2 90 H 70" stroke="currentColor" stroke-width="1.2" />
              <path class="bridge-pulse" d="M2 90 H 70" stroke="var(--accent)" stroke-width="1.6" />
            </svg>
            <div class="bridge-chip">
              <span class="bridge-glyph">.zip</span>
            </div>
          </div>

          <div class="stage-pane stage-pane-output">
            <div class="pane-caption">{copy.heroScenes[2].outputLabel}</div>
            <div class="stage-code" role="region" aria-label={copy.heroScenes[2].outputLabel}>
              <div class="code-line"><span class="tok-brace">&#123;</span></div>
              {copy.heroPack.jsonFields.map((field, idx) => (
                <div class="code-line code-indent">
                  <span class="tok-key">"{field.key}"</span><span class="tok-punct">: </span><span class={field.type === 'str' ? 'tok-str' : field.val === 'false' ? 'tok-bool' : 'tok-num'}>{field.val}</span>{idx < copy.heroPack.jsonFields.length - 1 ? <span class="tok-punct">,</span> : ''}
                </div>
              ))}
              <div class="code-line"><span class="tok-brace">&#125;</span></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="spec-strip-section" aria-label={copy.specStripAriaLabel}>
  <div class="container">
    <dl class="spec-strip-grid">
      {copy.specStrip.map((item) => (
        <div class="spec-strip-cell">
          <dt class="spec-strip-value">{item.value}</dt>
          <dd class="spec-strip-label">{item.label}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
