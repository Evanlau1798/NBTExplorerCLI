---
import contract from '../../../fixtures/verification/cli-command-surface.json';
import {
  COMMAND_SURFACE,
  SAFETY_LABELS,
  TRANSLATE_SUBCOMMANDS,
  type CommandEntry,
  type LocaleKey,
} from '../data/cli-surface';

interface Props {
  lang?: LocaleKey;
  group?: CommandEntry['group'] | 'all' | 'translate-sub' | 'agent-sub';
}

const { lang = 'en', group = 'all' } = Astro.props;
const labels = SAFETY_LABELS[lang] ?? SAFETY_LABELS.en;
const subcommandGroup = group === 'translate-sub' ? 'translate' : group === 'agent-sub' ? 'agent' : null;
const options = (command: string, subcommand: string | null = null) =>
  contract.entries.find((entry) => entry.command === command && entry.subcommand === subcommand)?.options ?? [];
const subcommands = contract.entries.filter((entry) => entry.command === subcommandGroup && entry.subcommand !== null);

const ui = {
  en: {
    required: 'Inputs',
    next: 'Result',
    options: 'Options',
    copy: 'Copy command syntax',
    copied: 'Copied',
    copyFailed: 'Copy failed',
  },
  'zh-tw': {
    required: '必要輸入',
    next: '輸出與下一步',
    options: '支援選項',
    copy: '複製指令語法',
    copied: '已複製',
    copyFailed: '複製失敗',
  },
}[lang] ?? {
  required: 'Inputs',
  next: 'Result',
  options: 'Options',
  copy: 'Copy command syntax',
  copied: 'Copied',
  copyFailed: 'Copy failed',
};

const filteredCommands =
  group === 'all'
    ? COMMAND_SURFACE
    : subcommandGroup
      ? []
      : COMMAND_SURFACE.filter((c) => c.group === group);
---

{
  !subcommandGroup && (
    <div class="nbt-cmd-list not-content">
      {filteredCommands.map((cmd) => {
        const flags = options(cmd.id);
        const summary = cmd.summary[lang] ?? cmd.summary.en;
        const searchIndex = [cmd.syntax, summary, ...flags].join(' ').toLowerCase();
        return (
          <div class="nbt-cmd-card" id={`cmd-${cmd.id}`} data-cmd-card data-tier={cmd.tier} data-search={searchIndex}>
            <div class="nbt-cmd-card-top">
              <div class="nbt-cmd-syntax-group">
                <code class="nbt-cmd-syntax">{cmd.syntax}</code>
                <button
                  type="button"
                  class="nbt-cmd-copy"
                  data-copy-cmd={cmd.syntax}
                  data-copy-label={ui.copy}
                  data-copied-label={ui.copied}
                  data-copy-failed-label={ui.copyFailed}
                  aria-label={ui.copy}
                  title={ui.copy}
                >
                  <svg class="nbt-icon-copy" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                    <rect x="5.25" y="5.25" width="8.5" height="8.5" rx="1.5" />
                    <path d="M10.75 5.25V3.5a1.25 1.25 0 0 0-1.25-1.25h-6A1.25 1.25 0 0 0 2.25 3.5v6a1.25 1.25 0 0 0 1.25 1.25h1.75" />
                  </svg>
                  <svg class="nbt-icon-check" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                    <path d="m3.5 8.5 3 3 6-6.5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </button>
              </div>
              <span class="nbt-pill" data-tier={cmd.tier}>
                <span class="nbt-safety-dot" aria-hidden="true" />
                {labels[cmd.tier].badge}
              </span>
            </div>
            <p class="nbt-cmd-summary">{summary}</p>
            <div class="nbt-cmd-meta">
              <div>
                <span class="nbt-cmd-meta-label">{ui.required}</span>
                <span>{cmd.requiredArgs[lang] ?? cmd.requiredArgs.en}</span>
              </div>
              <div>
                <span class="nbt-cmd-meta-label">{ui.next}</span>
                <span>{cmd.resultAndNext[lang] ?? cmd.resultAndNext.en}</span>
              </div>
            </div>
            {flags.length > 0 && (
              <div class="nbt-cmd-options-wrap">
                <span class="nbt-cmd-meta-label">{ui.options}</span>
                <div class="nbt-flag-list">
                  {flags.map((flag) => (
                    <code class="nbt-flag-chip">{flag}</code>
                  ))}
                </div>
              </div>
            )}
          </div>
        );
      })}
    </div>
  )
}

{
  subcommandGroup && (
    <div class="nbt-cmd-list not-content">
      {subcommands.map((sub) => {
        const detail =
          subcommandGroup === 'translate'
            ? TRANSLATE_SUBCOMMANDS.find((entry) => entry.subcommand === sub.subcommand)
            : undefined;
        const tier = detail?.tier ?? (sub.subcommand === 'setup' || sub.subcommand === 'submit' ? 'preview' : 'safe');
        const targetArg =
          sub.subcommand === 'help'
            ? ''
            : subcommandGroup === 'translate' && sub.subcommand === 'fallback'
              ? ' <world-or-file>'
              : ' <world>';
        const syntax = `nbtcli ${subcommandGroup} ${sub.subcommand}${targetArg}`;
        const summary = detail ? (detail.summary[lang] ?? detail.summary.en) : '';
        const searchIndex = [syntax, summary, ...sub.options].join(' ').toLowerCase();
        return (
          <div
            class="nbt-cmd-card"
            id={`${subcommandGroup}-${sub.subcommand}`}
            data-cmd-card
            data-tier={tier}
            data-search={searchIndex}
          >
            <div class="nbt-cmd-card-top">
              <div class="nbt-cmd-syntax-group">
                <code class="nbt-cmd-syntax">{syntax}</code>
                <button
                  type="button"
                  class="nbt-cmd-copy"
                  data-copy-cmd={syntax}
                  data-copy-label={ui.copy}
                  data-copied-label={ui.copied}
                  data-copy-failed-label={ui.copyFailed}
                  aria-label={ui.copy}
                  title={ui.copy}
                >
                  <svg class="nbt-icon-copy" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                    <rect x="5.25" y="5.25" width="8.5" height="8.5" rx="1.5" />
                    <path d="M10.75 5.25V3.5a1.25 1.25 0 0 0-1.25-1.25h-6A1.25 1.25 0 0 0 2.25 3.5v6a1.25 1.25 0 0 0 1.25 1.25h1.75" />
                  </svg>
                  <svg class="nbt-icon-check" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                    <path d="m3.5 8.5 3 3 6-6.5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </button>
              </div>
              <span class="nbt-pill" data-tier={tier}>
                <span class="nbt-safety-dot" aria-hidden="true" />
                {labels[tier].badge}
              </span>
            </div>
            {summary && <p class="nbt-cmd-summary">{summary}</p>}
            {sub.options.length > 0 && (
              <div class="nbt-cmd-options-wrap">
                <span class="nbt-cmd-meta-label">{ui.options}</span>
                <div class="nbt-flag-list">
                  {sub.options.map((flag) => (
                    <code class="nbt-flag-chip">{flag}</code>
                  ))}
                </div>
              </div>
            )}
          </div>
        );
      })}
    </div>
  )
}
