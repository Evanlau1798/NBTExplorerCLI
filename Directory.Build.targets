<Project>
  <Target Name="CheckArchitecture" BeforeTargets="PrepareForBuild;CoreCompile;ComputeFilesToPublish">
    <PropertyGroup>
      <_RewriteRoot>$(MSBuildThisFileDirectory)</_RewriteRoot>
      <_OwnSourceRootUpper>$([System.String]::Copy('$([MSBuild]::EnsureTrailingSlash($(MSBuildProjectDirectory)))').ToUpperInvariant())</_OwnSourceRootUpper>
    </PropertyGroup>
    <ItemGroup>
      <_AllowedProject Include="$(_RewriteRoot)src/Next.Domain/Next.Domain.csproj"
        Condition="'$(MSBuildProjectName)' == 'Next.Formats' Or '$(MSBuildProjectName)' == 'Next.Minecraft' Or '$(MSBuildProjectName)' == 'Next.Application' Or '$(MSBuildProjectName)' == 'Next.Infrastructure' Or '$(MSBuildProjectName)' == 'Next.Cli' Or '$(MSBuildProjectName)' == 'Next.Verification' Or '$(MSBuildProjectName)' == 'Next.Benchmarks'" />
      <_AllowedProject Include="$(_RewriteRoot)src/Next.Formats/Next.Formats.csproj"
        Condition="'$(MSBuildProjectName)' == 'Next.Minecraft' Or '$(MSBuildProjectName)' == 'Next.Application' Or '$(MSBuildProjectName)' == 'Next.Infrastructure' Or '$(MSBuildProjectName)' == 'Next.Cli' Or '$(MSBuildProjectName)' == 'Next.Verification' Or '$(MSBuildProjectName)' == 'Next.Benchmarks'" />
      <_AllowedProject Include="$(_RewriteRoot)src/Next.Minecraft/Next.Minecraft.csproj"
        Condition="'$(MSBuildProjectName)' == 'Next.Application' Or '$(MSBuildProjectName)' == 'Next.Infrastructure' Or '$(MSBuildProjectName)' == 'Next.Cli' Or '$(MSBuildProjectName)' == 'Next.Verification' Or '$(MSBuildProjectName)' == 'Next.Benchmarks'" />
      <_AllowedProject Include="$(_RewriteRoot)src/Next.Application/Next.Application.csproj"
        Condition="'$(MSBuildProjectName)' == 'Next.Infrastructure' Or '$(MSBuildProjectName)' == 'Next.Cli' Or '$(MSBuildProjectName)' == 'Next.Verification' Or '$(MSBuildProjectName)' == 'Next.Benchmarks'" />
      <_AllowedProject Include="$(_RewriteRoot)src/Next.Infrastructure/Next.Infrastructure.csproj"
        Condition="'$(MSBuildProjectName)' == 'Next.Cli' Or '$(MSBuildProjectName)' == 'Next.Verification' Or '$(MSBuildProjectName)' == 'Next.Benchmarks'" />
      <_AllowedProject Include="$(_RewriteRoot)src/Next.Cli/Next.Cli.csproj"
        Condition="'$(MSBuildProjectName)' == 'Next.Verification'" />
      <_AllowedProject Include="$(_RewriteRoot)benchmarks/Next.Benchmarks/Next.Benchmarks.csproj"
        Condition="'$(MSBuildProjectName)' == 'Next.Verification'" />
      <_ReferencedProject Include="@(ProjectReference->'%(FullPath)')" />
      <_ForbiddenProject Include="@(_ReferencedProject)" Exclude="@(_AllowedProject)" />
      <_ForbiddenCompile Include="@(Compile)"
        Condition="!$([System.String]::Copy('%(Compile.FullPath)').ToUpperInvariant().StartsWith('$(_OwnSourceRootUpper)'))" />
      <_ManualAssembly Include="@(Reference)" />
    </ItemGroup>
    <Error Code="NBTARCH001" Condition="'@(_ForbiddenProject)' != ''"
      Text="Project reference violates the vNext dependency graph: @(_ForbiddenProject)" />
    <Error Code="NBTARCH002" Condition="'@(_ForbiddenCompile)' != ''"
      Text="Compile input must stay inside its owning project: @(_ForbiddenCompile)" />
    <Error Code="NBTARCH003" Condition="'@(_ManualAssembly)' != ''"
      Text="Direct assembly references are forbidden; use the allowed project graph: @(_ManualAssembly)" />
    <Error Code="NBTARCH004" Condition="'$(MSBuildProjectName)' == 'Next.Domain' And '@(PackageReference)' != ''"
      Text="Domain must use only framework references." />
  </Target>
  <Target Name="CheckFinalCompileInputs" AfterTargets="CoreCompile">
    <PropertyGroup>
      <_FinalSourceRootUpper>$([System.String]::Copy('$([MSBuild]::EnsureTrailingSlash($(MSBuildProjectDirectory)))').ToUpperInvariant())</_FinalSourceRootUpper>
    </PropertyGroup>
    <ItemGroup>
      <_ForbiddenFinalCompile Include="@(Compile)"
        Condition="!$([System.String]::Copy('%(Compile.FullPath)').ToUpperInvariant().StartsWith('$(_FinalSourceRootUpper)'))" />
    </ItemGroup>
    <Error Code="NBTARCH002" Condition="'@(_ForbiddenFinalCompile)' != ''"
      Text="Final compile input must stay inside its owning project: @(_ForbiddenFinalCompile)" />
  </Target>
</Project>
